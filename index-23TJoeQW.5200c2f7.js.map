	 * Creates a ServerKeyExchange message.
	 *
	 * @param c the connection.
	 *
	 * @return the ServerKeyExchange byte buffer.
	 */ tls.createServerKeyExchange = function(c) {
        // build record fragment
        var rval = forge.util.createBuffer();
        return rval;
    };
