        var cAs = forge.util.createBuffer();
        for(var key in c.caStore.certs){
            var cert = c.caStore.certs[key];
            var dn = forge.pki.distinguishedNameToAsn1(cert.subject);
            var byteBuffer = forge.asn1.toDer(dn);
